# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE APIS Y CREDENCIALES
# Copia este archivo a ".env" y reemplaza con tus claves reales.
# ==============================================================================

# 1. API DIRECTA DE DXFEED (Opciones OPRA, Futuros CME, Order Flow TimeAndSale)
# Obtén tu token en https://dxfeed.com
DXFEED_AUTH_TOKEN=tu_token_de_dxfeed_aqui
DXFEED_ENDPOINT=wss://live.dxfeed.com/live/websocket

# 2. TASTYTRADE / DXLINK (Si usas cuenta de broker Tastytrade)
TT_REFRESH=tu_refresh_token_aqui
TASTYTRADE_CLIENT_ID=tu_client_id_aqui
TASTYTRADE_CLIENT_SECRET=tu_client_secret_aqui

# 3. DATABENTO (Opcional, para histórico)
# Obtén tu clave en https://databento.com
DATABENTO_API_KEY=db-tu_clave_databento_aqui
